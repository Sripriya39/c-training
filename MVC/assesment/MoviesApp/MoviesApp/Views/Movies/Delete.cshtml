@model  MoviesApp.Controllers.MoviesController

<h2>Delete Movie</h2>

<div>
    <h4>Are you sure you want to delete this movie?</h4>
    <p>Movie Name: @Model.MovieName</p>
    <p>Date of Release: @Model.DateOfRelease.ToShortDateString()</p>
</div>

@using (Html.BeginForm())
{
    <input type="submit" value="Delete" />
    @Html.ActionLink("Cancel", "Index")
}